# =========================================================
# TitanCRM Environment Configuration
# =========================================================
# Please fill in all variables below with your own credentials.
# You can obtain all required values by following the setup guide:
# 👉 https://docs.google.com/document/d/1npkPQs9O_Bshj4giDei89BFjfmimeCCjBLWwhh76zYg/edit?usp=sharing
#
# Do NOT use example/demo credentials in production.
# =========================================================


# =========================================================
# General / CRM Configuration
# =========================================================
# Email used for CRM login
# ⚠️ Must be a valid email address, as it will be used for logins and notifications
SEED_ADMIN_EMAIL=youremail@yourdomain.ltd


# =========================================================
# Application Domains
# =========================================================
# Specify your domains for each service
FRONTEND_DOMAIN=yourdomain.ltd
BACKEND_DOMAIN=api.yourdomain.ltd
RABBITMQ_DOMAIN=mq.yourdomain.ltd
PGADMIN_DOMAIN=db.yourdomain.ltd
DOZZLE_DOMAIN=log.yourdomain.ltd


# =========================================================
# Brevo (SMTP / Email Service)
# =========================================================
# Used for sending emails from the application
# IMPORTANT: Make sure to whitelist your server's public IP address
# in Brevo (API Keys / SMTP settings), otherwise requests may be rejected.
BREVO_USER=<brevo_user>
BREVO_API_KEY=<brevo_api>


# =========================================================
# Telegram Bot Configuration
# =========================================================
# Create bot via @BotFather and paste credentials here
TELEGRAM_BOT_NAME=<bot_name>
TELEGRAM_BOT_TOKEN=<bot_token>


# =========================================================
# S3-Compatible Object Storage Configuration
# =========================================================
# Used for storing media files (creatives, uploads, etc.)
# Works with AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces,
# Hetzner Object Storage, MinIO, Google Cloud Storage, and other S3-compatible providers.

# ---------------------------------------------------------
# Hetzner Object Storage
# How to get credentials:
#   1. Open Hetzner Cloud Console → your project → Object Storage
#   2. Click "Create Bucket", choose a location (e.g. Falkenstein = fsn1)
#   3. Open the bucket → "Access Keys" tab → "Generate S3 Access Keys"
#      (copy the Secret Key immediately — it is shown only once)
#   4. Endpoint and public URL pattern: <location>.your-objectstorage.com
#      Locations: fsn1 (Falkenstein), nbg1 (Nuremberg), hel1 (Helsinki), ash (Ashburn)
# ---------------------------------------------------------
#   S3_REGION=eu-central-1
#   S3_BUCKET=my-bucket
#   S3_ACCESS_KEY_ID=<access_key>
#   S3_SECRET_ACCESS_KEY=<secret_key>
#   S3_ENDPOINT=https://fsn1.your-objectstorage.com
#   S3_PUBLIC_URL=https://my-bucket.fsn1.your-objectstorage.com
#   S3_PUBLIC_HOSTNAME=my-bucket.fsn1.your-objectstorage.com
#   S3_FORCE_PATH_STYLE=false
#
#   NEXT_PUBLIC_S3_PROTOCOL=https
#   NEXT_PUBLIC_S3_HOSTNAME=my-bucket.fsn1.your-objectstorage.com
#   NEXT_PUBLIC_S3_PATHNAME=/creatives/**
#
# ---------------------------------------------------------
# AWS S3
# How to get credentials:
#   1. Open AWS Console → IAM → Users → your user → "Security credentials"
#   2. Click "Create access key" → copy Access Key ID and Secret Access Key
#   3. Bucket name: S3 → your bucket name
#   4. Region: S3 → your bucket → Properties → AWS Region (e.g. eu-central-1)
# ---------------------------------------------------------
#   S3_REGION=eu-central-1
#   S3_BUCKET=my-bucket
#   S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
#   S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#   S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#   S3_PUBLIC_URL=https://my-bucket.s3.eu-central-1.amazonaws.com
#   S3_PUBLIC_HOSTNAME=my-bucket.s3.eu-central-1.amazonaws.com
#   S3_FORCE_PATH_STYLE=false
#
#   NEXT_PUBLIC_S3_PROTOCOL=https
#   NEXT_PUBLIC_S3_HOSTNAME=my-bucket.s3.eu-central-1.amazonaws.com
#   NEXT_PUBLIC_S3_PATHNAME=/creatives/**
#
# ---------------------------------------------------------
# Cloudflare R2
# How to get credentials:
#   1. Open Cloudflare Dashboard → R2 Object Storage → "Manage R2 API tokens"
#   2. Click "Create API token" → set permissions (Object Read & Write) → copy keys
#   3. Account ID: visible on the R2 overview page (right sidebar)
#   4. Public URL: R2 bucket → Settings → "Public access" → enable and copy the r2.dev URL
# ---------------------------------------------------------
#   S3_REGION=auto
#   S3_BUCKET=my-bucket
#   S3_ACCESS_KEY_ID=<r2_access_key_id>
#   S3_SECRET_ACCESS_KEY=<r2_secret_access_key>
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_PUBLIC_URL=https://pub-<token>.r2.dev
#   S3_PUBLIC_HOSTNAME=pub-<token>.r2.dev
#   S3_FORCE_PATH_STYLE=false
#
#   NEXT_PUBLIC_S3_PROTOCOL=https
#   NEXT_PUBLIC_S3_HOSTNAME=pub-<token>.r2.dev
#   NEXT_PUBLIC_S3_PATHNAME=/creatives/**
#
# ---------------------------------------------------------
# MinIO (self-hosted)
# How to get credentials:
#   1. Open MinIO Console → Identity → Users (or Service Accounts) → create account
#   2. Assign policy with s3:GetObject, s3:PutObject, s3:DeleteObject on your bucket
#   3. Endpoint is the URL of your MinIO instance
#   4. PUBLIC_URL pattern: <endpoint>/<bucket> (path-style, so FORCE_PATH_STYLE=true)
# ---------------------------------------------------------
#   S3_REGION=us-east-1
#   S3_BUCKET=my-bucket
#   S3_ACCESS_KEY_ID=<minio_access_key>
#   S3_SECRET_ACCESS_KEY=<minio_secret_key>
#   S3_ENDPOINT=https://minio.yourdomain.ltd
#   S3_PUBLIC_URL=https://minio.yourdomain.ltd/my-bucket
#   S3_PUBLIC_HOSTNAME=minio.yourdomain.ltd
#   S3_FORCE_PATH_STYLE=true
#
#   NEXT_PUBLIC_S3_PROTOCOL=https
#   NEXT_PUBLIC_S3_HOSTNAME=minio.yourdomain.ltd
#   NEXT_PUBLIC_S3_PATHNAME=/creatives/**

# AWS region or "auto" for Cloudflare R2
S3_REGION=<region>
# S3 bucket name
S3_BUCKET=<bucket_name>
# Access key ID (AWS access key, R2 access key, MinIO access key, etc.)
S3_ACCESS_KEY_ID=<access_key_id>
# Secret access key
S3_SECRET_ACCESS_KEY=<secret_access_key>
# Provider API endpoint URL (required for non-AWS providers; for AWS use https://s3.<region>.amazonaws.com)
S3_ENDPOINT=https://s3.<region>.amazonaws.com
# Full public base URL for accessing uploaded files (used to construct public file URLs)
S3_PUBLIC_URL=https://<bucket_name>.s3.<region>.amazonaws.com
# Hostname only (no protocol, no path) — used by the frontend for image domain allowlist
S3_PUBLIC_HOSTNAME=<bucket_name>.s3.<region>.amazonaws.com
# Set to true only for MinIO and GCS which require path-style routing (endpoint/bucket/key)
S3_FORCE_PATH_STYLE=false

# ============================================================
# AUTO-GENERATED VALUES
# DO NOT MODIFY MANUALLY
# These values are generated automatically by deploy.sh.
# ============================================================
PGADMIN_DEFAULT_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
SEED_ADMIN_PASSWORD=
